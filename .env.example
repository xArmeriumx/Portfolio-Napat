# Never commit real values. Each environment must use the matching isolated
# PostgreSQL schema in the connection URL: portfolio_cms_dev, _preview, _prod.
CONTENT_STORAGE=static
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=portfolio_cms_dev

# Better Auth (server-only; use a random value of at least 32 characters).
BETTER_AUTH_SECRET=replace-with-a-random-32-plus-character-secret
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PREVIEW_SIGNING_SECRET=replace-with-a-different-random-32-plus-character-secret

# One-time bootstrap only. Remove after activation.
ADMIN_ACTIVATION_TOKEN=replace-with-a-one-time-random-token
ADMIN_EMAIL=napat.pamornsut@gmail.com

# Supabase Storage server-only values. Keep the bucket dedicated to Portfolio.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
PORTFOLIO_STORAGE_BUCKET=portfolio-cms
SUPABASE_STORAGE_PUBLIC_BASE_URL=https://PROJECT_REF.supabase.co/storage/v1/object/public/portfolio-cms
